{
  "headers": [
    {
      "source": "/data/(.*\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pe-ratio.html",
      "destination": "/valuations.html",
      "permanent": true
    }
  ]
}
